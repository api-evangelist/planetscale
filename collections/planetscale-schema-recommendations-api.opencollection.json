{
  "opencollection": "1.0.0",
  "info": {
    "name": "PlanetScale Platform Backups Schema Recommendations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Schema Recommendations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List schema recommendations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.planetscale.com/v1/organizations/:organization/databases/:database/schema-recommendations",
            "params": [
              {
                "name": "organization",
                "value": "",
                "type": "path",
                "description": "The name of the organization."
              },
              {
                "name": "database",
                "value": "",
                "type": "path",
                "description": "The name of the database."
              }
            ]
          },
          "docs": "Returns a list of schema recommendations for the specified database, identifying potential optimization opportunities."
        }
      ]
    }
  ],
  "bundled": true
}