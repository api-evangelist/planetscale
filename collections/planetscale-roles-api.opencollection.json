                "description": "The name of the organization."
              },
              {
                "name": "database",
                "value": "",
                "type": "path",
                "description": "The name of the database."
              },
              {
                "name": "branch",
                "value": "",
                "type": "path",
                "description": "The name of the branch."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates role-based credentials for accessing a database branch with specific permissions."
        }
      ]
    }
  ],
  "bundled": true
